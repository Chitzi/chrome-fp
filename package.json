{
  "name": "chrome-fp",
  "version": "1.1.0",
  "description": "Launch a throwaway Chrome instance with a fresh, internally consistent fingerprint on every run",
  "bin": {
    "chrome-fp": "./chrome-fp"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "gui": "node src/index.js --gui",
    "verify": "node test/verify.js",
    "app": "electron electron/main.js",
    "pack:linux": "electron-builder --linux AppImage deb",
    "pack:win": "electron-builder --win nsis portable",
    "pack:all": "electron-builder --linux AppImage deb --win nsis portable"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Chitzi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chitzi/chrome-fp.git"
  },
  "build": {
    "appId": "com.github.chitzi.chromefp",
    "productName": "chrome-fp",
    "copyright": "MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!test/**",
      "!dist/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Chitzi <noreply@github.com>",
      "synopsis": "Throwaway Chrome instances with a fresh fingerprint",
      "description": "Launches real Chrome instances in disposable profiles, each with a freshly generated, internally consistent browser fingerprint.",
      "desktop": {
        "entry": {
          "Name": "chrome-fp",
          "StartupWMClass": "chrome-fp"
        }
      },
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icons/256x256.png",
        "to": "icon.png"
      }
    ]
  }
}
